use_default_settings: true

general:
  instance_name: "SearXNG"

server:
  # IMPORTANT: Generate a random 64-character hex string for your local setup.
  # Example command: python3 -c "import secrets; print(secrets.token_hex(32))"
  secret_key: "CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"
  limiter: false
  image_proxy: true
  port: 8080
  bind_address: "0.0.0.0"

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "en"
  formats:
    - html
    - json
